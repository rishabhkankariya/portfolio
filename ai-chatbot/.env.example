# Server
PORT=4500
ALLOWED_ORIGIN=http://localhost:3000

# AI Master Switch
AI_ENABLED=true
AI_PROVIDER=gemini

# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_MS=8000

# Ollama (local fallback / alternate provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=15000

# Conversation Context TTL
CONTEXT_TTL_MS=1800000
CONFIRMATION_TTL_MS=300000
